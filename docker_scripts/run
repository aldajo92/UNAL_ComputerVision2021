#!/bin/bash

set -e

PROJECT_ROOT="$(cd "$(dirname "$0")"; cd ..; pwd)"
source ${PROJECT_ROOT}/config.sh

echo "Starting JupyterLab container..."
echo "Access at: http://localhost:8899"
echo "Password: unal2021"
echo ""

docker run -it \
  -p 8899:8899 \
  --name=${PROJECT_NAME} \
  --volume ${PROJECT_ROOT}:/workspace \
  --hostname=cvproject.local  \
  --rm \
  ${PROJECT_NAME}
